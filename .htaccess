# ============================================================
#  adwali.com  .htaccess
#  Canonical domain, 24-hour cache buster, security, dynamic sitemap
# ============================================================
Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

RewriteEngine On

# ---- Canonical: force HTTPS + www -> https://www.adwali.com/ ----
RewriteCond %{HTTP_HOST} ^adwali\.com [NC]
RewriteRule ^(.*)$ https://www.adwali.com/$1 [R=301,L]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://www.adwali.com/$1 [R=301,L]

# ---- Dynamic sitemap: sitemap.xml is generated live by sitemap.php ----
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# ---- MIME types ----
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
</IfModule>

# ---- Cache policy: everything cache-busts within 24 hours ----
#  HTML + PHP: never cached, every visit gets the freshest page.
#  All assets (css/js/fonts/images): cached max 24h, then re-fetched.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  <FilesMatch "\.(html|htm|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|mjs|woff2|woff|ttf|otf|png|jpe?g|gif|svg|webp|avif|ico|webmanifest|json|xml|txt|mp4|webm)$">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=3600"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresDefault "access plus 24 hours"
</IfModule>

# ---- Compression ----
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml text/xml image/svg+xml font/woff2 application/manifest+json
</IfModule>
